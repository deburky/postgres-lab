{
  "name": "sync-async-city",
  "private": true,
  "version": "0.1.0",
  "description": "A small three.js city that replays a measured SQLAlchemy sync vs async trace",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "record": "node record.mjs 9",
    "record:neon": "CITY_THEME=neon node record.mjs 9",
    "record:queue": "CITY_PAGE=queue node record.mjs 10",
    "record:queue-retry": "CITY_PAGE=queue CITY_PRESET=retry node record.mjs 10",
    "save-traces": "node save-traces.mjs",
    "test:sql": "node test-sql.mjs",
    "build:book": "VITE_TRACES=./traces/ vite build --outDir ../book/viz --emptyOutDir"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
