# Copy to .env (git-ignored). Values match the guide's defaults.
POSTGRES_USER=app
POSTGRES_PASSWORD=pwd
POSTGRES_DB=app
POSTGRES_PORT=5432

# Used by src/db.py. psycopg 3 dialect; SQLAlchemy uses it for both sync and async engines.
DATABASE_URL=postgresql+psycopg://app:pwd@localhost:5432/app

# asyncpg alternative (guide default), also installed:
# DATABASE_URL=postgresql+asyncpg://app:pwd@localhost:5432/app

# Lets `docker compose` find the compose file from the project root.
COMPOSE_FILE=docker/postgres-pgvector.yaml

# Lets scripts in src/examples/** import db.py and models.py.
PYTHONPATH=src

# Engine knobs read by src/settings.py (defaults shown). DB_ECHO=false silences the SQL log.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_ECHO=true

# pgrust (docker/pgrust.yaml), Postgres-18-in-Rust on a second port. Bundles pgvector 0.8.5.
PGRUST_PORT=5433
PGRUST_DATABASE_URL=postgresql+psycopg://app:pwd@localhost:5433/app

# Same two servers on a local kind cluster (k8s/kind-cluster.yaml maps the NodePorts to these host ports).
K8S_PG16_DATABASE_URL=postgresql+psycopg://app:pwd@localhost:5434/app
K8S_PGRUST_DATABASE_URL=postgresql+psycopg://app:pwd@localhost:5435/app

# Pulumi (pulumi/): local state backend, secrets encrypted with this passphrase (dev only).
PULUMI_BACKEND_URL=file://~
PULUMI_CONFIG_PASSPHRASE=dev

# PgBouncer (docker/pgbouncer.yaml) in front of the pg16 container, transaction pooling.
PGBOUNCER_PORT=6432
PGBOUNCER_DATABASE_URL=postgresql+psycopg://app:pwd@localhost:6432/app

# second pg16 subscribed to the first with logical replication (docker/postgres-pgvector.yaml --profile replica)
REPLICA_PORT=5440
REPLICA_DATABASE_URL=postgresql+psycopg://app:pwd@localhost:5440/app

# Same two servers on a local k3d cluster (k8s/k3d-cluster.yaml maps the NodePorts to these host ports via k3d's load balancer).
K3D_PG16_DATABASE_URL=postgresql+psycopg://app:pwd@localhost:5436/app
K3D_PGRUST_DATABASE_URL=postgresql+psycopg://app:pwd@localhost:5437/app

# k3s in one container, started by k8s/k3s.py through the Docker SDK (host ports 5438/5439)
K3S_PG16_DATABASE_URL=postgresql+psycopg://app:pwd@localhost:5438/app
K3S_PGRUST_DATABASE_URL=postgresql+psycopg://app:pwd@localhost:5439/app

# Apache Doris as a CDC target (docker/postgres-pgvector.yaml --profile doris): FE on 9030 (MySQL protocol), web UI on 8030
DORIS_PORT=9030
DORIS_HTTP_PORT=8030
DORIS_URL=mysql+pymysql://root@localhost:9030

# pg18 (docker/pg18.yaml): Postgres 18 + pgvector + pgvectorscale + pg_vectorsearch (prism index)
PG18_PORT=5441
PG18_DATABASE_URL=postgresql+psycopg://app:pwd@localhost:5441/app

# pgsesame (pgsesame/spec.yaml): passwords for the two demo login roles, read via password_env
SESAME_REPORTER_PASSWORD=reporter-pw
SESAME_INGEST_PASSWORD=ingest-pw
